# Server-only. neon deploy pulls provider values into root .env.local.
# Copy to apps/parent-web/.env.local and add the app-specific values below.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
STORAGE_BUCKET=assets
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
