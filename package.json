{
  "name": "sideby",
  "private": true,
  "workspaces": [
    "apps/parent-web",
    "apps/website",
    "apps/admin"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@sideby/parent-web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev:website": "npm run dev --workspace=@sideby/website",
    "build:website": "npm run build --workspace=@sideby/website",
    "env:dev": "node scripts/use-environment.mjs dev",
    "env:production": "node scripts/use-environment.mjs production",
    "dev:media": "node --env-file=.env.local scripts/start-live-local.mjs",
    "dev:admin": "npm run dev --workspace=@sideby/admin"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
